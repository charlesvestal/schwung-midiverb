{
  "title": "Midiverb",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Emulator of the",
        "Alesis Midiverb,",
        "Midifex, and",
        "Midiverb II rack",
        "reverbs.",
        "",
        "DSP runs at the",
        "native 23.4 kHz",
        "with a 32-tap",
        "polyphase resampler."
      ]
    },
    {
      "title": "Controls",
      "lines": [
        "Jog wheel:",
        "scroll programs",
        "",
        "Knobs 1-4: Mix,",
        "Feedback, In Gain,",
        "Out Gain",
        "",
        "Knobs 5-8: PreDly,",
        "Low Cut, High Cut,",
        "Width",
        "",
        "Two submenus:",
        "Extras and Unit."
      ]
    },
    {
      "title": "Extras",
      "lines": [
        "Four more knobs on",
        "the Extras submenu:",
        "",
        "Damping: 0-1, a one-",
        " pole lowpass inside",
        " the feedback path.",
        " 0 is about 3 kHz,",
        " 1 about 50 Hz.",
        "",
        "Tilt: -1 to +1.",
        " Above 0 it raises",
        " Low Cut toward",
        " 1 kHz (brighter);",
        " below 0 it lowers",
        " High Cut toward",
        " 1 kHz (darker).",
        "",
        "LFO Depth: 0-1,",
        " scales the program's",
        " own LFO. Only some",
        " programs have one;",
        " on the rest it does",
        " nothing.",
        "",
        "LFO Rate: 0-4x. The",
        " DSP does not read",
        " this yet - the LFO",
        " runs at the rate",
        " baked into the",
        " program."
      ]
    },
    {
      "title": "Units",
      "lines": [
        "Three units in the",
        "Unit submenu:",
        "",
        "Midiverb (64 prgs)",
        "Midifex  (64 prgs)",
        "Midiverb II",
        "(100 prgs)"
      ]
    }
  ]
}
